{
  "buildCommand": "cd ../.. && pnpm build",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/appointment-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/recurring-jobs",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/coaching-nudges",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/no-show-detector",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/finalize-account-deletions",
      "schedule": "0 3 * * *"
    }
  ]
}

